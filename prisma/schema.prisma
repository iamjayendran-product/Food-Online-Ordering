// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  orders    Order[]
  favorites Favorite[]
}

model Restaurant {
  id      String   @id @default(cuid())
  slug    String   @unique
  name    String
  cuisines String[]
  address String
  // Several photos per restaurant, shown as a carousel on the discovery card.
  // An empty array means the card falls back to its initials tile and renders
  // no <img> at all.
  images   String[]
  // Advertised pickup wait, in minutes.
  pickupMinutes Int   @default(15)
  ratingAvg     Float @default(4.5)
  reviewCount   Int   @default(0)

  categories MenuCategory[]
  items      MenuItem[]
  orders     Order[]
  favorites  Favorite[]
  campaigns  Campaign[]
}

model MenuCategory {
  id           String @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@unique([restaurantId, name])
}

model MenuItem {
  id            String  @id @default(cuid())
  restaurantId  String
  categoryId    String
  name          String
  description   String?
  pricePaise    Int
  isVeg         Boolean
  isAvailable   Boolean @default(true)
  imageUrl      String?
  isRecommended Boolean @default(false)
  sortOrder     Int

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([categoryId, name])
  @@index([restaurantId])
}

model Campaign {
  id           String  @id @default(cuid())
  restaurantId String
  headline     String
  imageUrl     String?
  sortOrder    Int

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, headline])
}

model Favorite {
  id           String   @id @default(cuid())
  userId       String
  restaurantId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([userId])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  PLACED
}

enum PaymentMethod {
  CASH
  ONLINE
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     Int           @unique @default(autoincrement())
  userId          String
  restaurantId    String
  status          OrderStatus
  subtotalPaise   Int
  gstPaise        Int
  totalPaise      Int
  paymentProvider String
  paymentMethod   PaymentMethod
  paymentRef      String?
  // null = ASAP pickup (the only behavior before pre-order scheduling existed).
  scheduledFor    DateTime?
  createdAt       DateTime      @default(now())

  user       User        @relation(fields: [userId], references: [id])
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  items      OrderItem[]

  @@index([userId])
  @@index([restaurantId])
}

model OrderItem {
  id              String @id @default(cuid())
  orderId         String
  menuItemId      String
  name            String
  unitPricePaise  Int
  quantity        Int
  lineTotalPaise  Int

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
}
