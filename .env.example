# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://tnagar_food:tnagar_food@localhost:5432/tnagar_food_ordering?schema=public"

# Used only by the Playwright test suite. Same container, separate database,
# so `npm test` can freely reset its data without touching DATABASE_URL's.
TEST_DATABASE_URL="postgresql://tnagar_food:tnagar_food@localhost:5432/tnagar_food_ordering_test?schema=public"

# Used to sign session JWTs (see src/lib/session.ts). Any long random string
# for local dev; generate one with `openssl rand -base64 32`.
SESSION_SECRET="dev-secret-change-me"

# Used by docker-compose.yml to configure the local Postgres container.
# Keep these in sync with the credentials embedded in DATABASE_URL above.
POSTGRES_USER=tnagar_food
POSTGRES_PASSWORD=tnagar_food
POSTGRES_DB=tnagar_food_ordering